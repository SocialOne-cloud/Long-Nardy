# Firebase web app config — Project settings -> General -> Your apps -> SDK setup.
# Copy this file to .env.local and paste your own values. These keys identify
# the project rather than granting access; the database rules do the guarding.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional: point the app at `firebase emulators:start` instead of the real
# project, for trying things out without touching your live room data.
# VITE_USE_EMULATORS=true
